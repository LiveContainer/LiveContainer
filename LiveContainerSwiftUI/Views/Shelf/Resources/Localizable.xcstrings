    },
    "Not syncing this time; starting with this device’s save": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not syncing this time; starting with this device’s save"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sincroniza esta vez; se inicia con la partida guardada de este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de synchro cette fois ; démarrage avec la sauvegarde de cet appareil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は同期せず、このデバイスのセーブデータで開始します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次先不同步，用这台设备的存档开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
