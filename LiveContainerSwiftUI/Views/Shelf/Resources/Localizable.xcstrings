    "Each player has their own saves in every game. The game starts as the player picked here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Spieler hat in jedem Spiel eigene Spielstände. Das Spiel startet mit dem hier gewählten Spieler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each player has their own saves in every game. The game starts as the player picked here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada jugador tiene sus propias partidas guardadas en cada juego. El juego inicia con el jugador elegido aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque joueur a ses propres sauvegardes dans chaque jeu. Le jeu démarre avec le joueur choisi ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni giocatore ha i propri salvataggi in ogni gioco. Il gioco si avvia con il giocatore scelto qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイヤーごとに、どのゲームにも自分のセーブデータがあります。ゲームはここで選んだプレイヤーで始まります。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje spelare har egna sparfiler i alla spel. Spelet startar som spelaren du väljer här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个玩家在每款游戏里都有自己的存档。开始游戏时用这里选的玩家。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個玩家在每款遊戲裡都有自己的存檔。開始遊戲時用這裡選的玩家。"
          }
        }
      }
    },
    "Remove %@? Their saves stay on this device. Add a player with the same name to get them back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ entfernen? Die Spielstände bleiben auf diesem Gerät. Füge einen Spieler mit demselben Namen hinzu, um sie zurückzubekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? Their saves stay on this device. Add a player with the same name to get them back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Sus partidas guardadas permanecen en este dispositivo. Añade un jugador con el mismo nombre para recuperarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %@ ? Ses sauvegardes restent sur cet appareil. Ajoutez un joueur du même nom pour les retrouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %@? I salvataggi restano su questo dispositivo. Aggiungi un giocatore con lo stesso nome per recuperarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しますか？セーブデータはこのデバイスに残ります。同じ名前のプレイヤーを追加すると元に戻ります。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort %@? Sparfilerna finns kvar på enheten. Lägg till en spelare med samma namn för att få tillbaka dem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@？存档仍留在这台设备上；再添加同名玩家就能找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@？存檔仍留在這臺裝置上；再新增同名玩家就能找回。"
          }
        }
      }
    },
