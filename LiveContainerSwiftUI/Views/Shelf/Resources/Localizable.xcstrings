          }
        }
      }
    },
    "iCloud hasn’t downloaded %@ to this device yet, so your save wasn’t changed. Connect to the internet, wait a moment, and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hasn’t downloaded %@ to this device yet, so your save wasn’t changed. Connect to the internet, wait a moment, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud aún no ha descargado %@ en este dispositivo, por lo que tu partida guardada no cambió. Conéctate a internet, espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n'a pas encore téléchargé %@ sur cet appareil, votre sauvegarde n'a pas changé. Connectez-vous à Internet, attendez un instant et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud がまだ %@ をこのデバイスにダウンロードしていないため、セーブデータは変更されませんでした。インターネットに接続し、少し待ってから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 还没把 %@ 下载到这台设备，存档没有改动。请联网稍等后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 還沒把 %@ 下載到這臺裝置，存檔沒有改動。請聯網稍等後再試。"
          }
        }
      }
    },
    "%@ in iCloud is incomplete, so your save wasn’t changed. Sync again on the other device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in iCloud is incomplete, so your save wasn’t changed. Sync again on the other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ en iCloud está incompleto, por lo que tu partida guardada no cambió. Sincroniza de nuevo en el otro dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dans iCloud est incomplet, votre sauvegarde n'a pas changé. Synchronisez à nouveau sur l'autre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 内の %@ が不完全なため、セーブデータは変更されませんでした。他のデバイスで再度同期してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 里的 %@ 不完整，存档没有改动。请在另一台设备上重新同步一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 裡的 %@ 不完整，存檔沒有改動。請在另一臺裝置上重新同步一次。"
          }
        }
      }
    },
    "Switched to the progress from %@, but couldn’t write it back to iCloud (%@). The save itself is fine; the next sync will write it again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switched to the progress from %@, but couldn’t write it back to iCloud (%@). The save itself is fine; the next sync will write it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cambió al progreso de %@, pero no se pudo escribir de nuevo en iCloud (%@). La partida guardada en sí está bien; la próxima sincronización la escribirá de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculé vers la progression de %@, mais impossible de la réécrire sur iCloud (%@). La sauvegarde elle-même est intacte ; la prochaine synchro la réécrira."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の進行状況に切り替えましたが、iCloud に書き戻せませんでした（%@）。セーブデータ自体は問題ありません。次回の同期時に再度書き込まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已换成 %@ 的进度，但没能写回 iCloud（%@）。存档本身没问题，下次同步会再写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已換成 %@ 的進度，但沒能寫回 iCloud（%@）。存檔本身沒問題，下次同步會再寫。"
          }
        }
      }
