    "Sends this device's logs to the developers and gives you a short code. You can add a sentence about what happened.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends this device's logs to the developers and gives you a short code. You can add a sentence about what happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía los registros de este dispositivo a los desarrolladores y te proporciona un código corto. Puedes añadir una frase sobre lo que ocurrió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les journaux de cet appareil aux développeurs et vous fournit un code court. Vous pouvez ajouter une phrase décrivant ce qui s'est passé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのログを開発者に送信し、短いコードを発行します。何が起きたかを一文追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这台设备的日志发给开发者，并给你一个短码。可以写一句发生了什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這臺裝置的日誌發給開發者，並給你一個短碼。可以寫一句發生了什麼。"
          }
        }
      }
    },
