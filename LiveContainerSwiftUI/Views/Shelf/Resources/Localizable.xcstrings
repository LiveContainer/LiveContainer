    "This package has no save service, so iCloud saves weren’t synced.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This package has no save service, so iCloud saves weren’t synced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paquete no tiene servicio de partidas guardadas, por lo que las partidas de iCloud no se sincronizaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paquet n'a pas de service de sauvegarde, les sauvegardes iCloud n'ont pas été synchronisées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパッケージにはセーブデータサービスがないため、iCloud セーブデータは同期されませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个安装包没有存档服务，iCloud 存档没同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個安裝包沒有存檔服務，iCloud 存檔沒同步。"
          }
        }
      }
    },
    "The save service didn’t return a valid result.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save service didn’t return a valid result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de partidas guardadas no devolvió un resultado válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de sauvegarde n'a pas renvoyé de résultat valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブサービスが有効な結果を返しませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档服务没有返回有效结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存檔服務沒有返回有效結果。"
          }
        }
      }
    },
    "The save was switched to the iCloud progress, but finishing up didn’t complete (%@). Save management will open before the game next starts to finish it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save was switched to the iCloud progress, but finishing up didn’t complete (%@). Save management will open before the game next starts to finish it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La partida guardada se cambió al progreso de iCloud, pero no se completó el proceso final (%@). La gestión de partidas guardadas se abrirá antes del próximo inicio del juego para terminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde a été remplacée par la progression iCloud, mais la finalisation n'a pas abouti (%@). La gestion des sauvegardes s'ouvrira avant le prochain démarrage du jeu pour terminer l'opération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータを iCloud の進行状況に切り替えましたが、完了処理が終わりませんでした（%@）。次回ゲーム起動前にセーブデータ管理画面が開き、処理を完了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档已经换成云端的进度，但收尾没做完（%@）。下次开始游戏前会先进存档管理页接着处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存檔已經換成雲端的進度，但收尾沒做完（%@）。下次開始遊戲前會先進存檔管理頁接著處理。"
          }
        }
      }
    },
    "The save list couldn’t be read completely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The save list couldn’t be read completely."
