    "Mix with Other Apps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mix with Other Apps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezclar con otras apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mixer avec d'autres apps"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の App とミックス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他 App 混音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與其他 App 混音"
          }
        }
      }
    },
    "When on, music or podcasts from other apps keep playing with the game, and the Silent switch only mutes the game.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, music or podcasts from other apps keep playing with the game, and the Silent switch only mutes the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, la música o los podcasts de otras apps siguen reproduciéndose con el juego, y el interruptor de Silencio solo silencia el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque activé, la musique ou les podcasts d'autres apps continuent de jouer avec le jeu, et l'interrupteur Silence ne coupe que le son du jeu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、他の App の音楽やポッドキャストがゲームと同時に再生され、サイレントスイッチはゲームのみをミュートします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后，别的 App 的音乐、播客和游戏一起放，静音键只静音游戏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，別的 App 的音樂、播客和遊戲一起放，靜音鍵只靜音遊戲。"
          }
        }
      }
    },
    "Where to find the settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where to find the settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
