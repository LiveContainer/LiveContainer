          }
        }
      }
    },
    "Turn cheats on one by one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn cheats on one by one"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa los trucos uno por uno"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les codes de triche un par un"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チートは 1 つずつオンにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金手指，进游戏逐条打开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金手指，進遊戲逐條開啟"
          }
        }
      }
    },
    "Stuck? Send us a report": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuck? Send us a report"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Problemas? Envíanos un informe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqué ? Envoyez-nous un rapport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "困ったら問題を報告"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到问题，一键报修"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遇到問題，一鍵報修"
          }
        }
      }
    },
    "**Gear at the top right**: settings for the whole app, such as interface, sound and reporting a problem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gear at the top right**: settings for the whole app, such as interface, sound and reporting a problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Engranaje arriba a la derecha**: ajustes de toda la app, como interfaz, sonido e informar de un problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Roue dentée en haut à droite** : réglages de l'ensemble de l'app, comme l'interface, le son et signaler un problème."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**右上の歯車**：アプリ全体の設定。インターフェース、サウンド、問題報告など。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**右上角齿轮**：整个 App 的设置，界面、声音、故障报修都在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**右上角齒輪**：整個 App 的設定，介面、聲音、故障報修都在這裡。"
          }
        }
      }
    },
    "**Select a game, then the sliders button at the top (Game settings)**: this game's picture, controls, community patches and cheats.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Select a game, then the sliders button at the top (Game settings)**: this game's picture, controls, community patches and cheats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Selecciona un juego y luego el botón de controles deslizantes arriba (Ajustes del juego)**: imagen, controles, parches de la comunidad y trucos de este juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sélectionnez un jeu, puis le bouton curseurs en haut (Réglages du jeu)** : l'image de ce jeu, les commandes, les correctifs de la communauté et les codes de triche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ゲームを選択 → 上部のスライダーボタン（ゲーム設定）**：このゲームの画面、コントロール、コミュニティパッチ、チート。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**选中一款游戏，点顶栏的调节图标（游戏设置）**：这款的画面、按键、社区补丁和金手指。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**選中一款遊戲，點頂欄的調節圖示（遊戲設定）**：這款的畫面、按鍵、社群補丁和金手指。"
          }
        }
      }
    },
    "**In a game, the gear at the top left** opens the same game settings at any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**In a game, the gear at the top left** opens the same game settings at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**En un juego, el engranaje arriba a la izquierda** abre los ajustes del juego en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dans un jeu, la roue dentée en haut à gauche** ouvre les mêmes réglages du jeu à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ゲーム中、左上の歯車**でいつでも同じゲーム設定を開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**游戏里左上角的齿轮**，随时打开这款的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**遊戲裡左上角的齒輪**，隨時開啟這款的設定。"
          }
        }
      }
    },
    "Cheats matched to your game's version come built in, and they start **off**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheats matched to your game's version come built in, and they start **off**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los trucos adaptados a la versión de tu juego vienen integrados y están **desactivados** por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes de triche correspondant à la version de votre jeu sont intégrés et sont **désactivés** par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームバージョンに合わせたチートが組み込まれていますが、デフォルトでは**オフ**です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的游戏版本配好的金手指已经打进包里，**默认是关的**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按你的遊戲版本配好的金手指已經打進包裡，**預設是關的**。"
          }
        }
      }
    },
    "In a game: **top-left gear → S-grade enhancements → Cheats**, then switch on the ones you want. Each takes effect in about a second.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a game: **top-left gear → S-grade enhancements → Cheats**, then switch on the ones you want. Each takes effect in about a second."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un juego: **engranaje arriba a la izquierda → Mejoras de grado S → Trucos**, luego activa los que quieras. Cada uno surte efecto en aproximadamente un segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un jeu : **roue dentée en haut à gauche → Améliorations de rang S → Codes de triche**, puis activez ceux que vous voulez. Chacun prend effet en environ une seconde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム中：**左上の歯車 → S グレード最適化 → チート**で、使いたいものをオンに。各チートは約 1 秒で有効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏里：**左上角齿轮 → S 级优化 → 金手指**，想用哪条就打开哪条，约 1 秒生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲裡：**左上角齒輪 → S 級優化 → 金手指**，想用哪條就開啟哪條，約 1 秒生效。"
          }
        }
      }
    },
    "Or set them up before playing: **select a game → sliders button at the top → Cheats**.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or set them up before playing: **select a game → sliders button at the top → Cheats**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O configúralos antes de jugar: **selecciona un juego → botón de controles deslizantes arriba → Trucos**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou configurez-les avant de jouer : **sélectionnez un jeu → bouton curseurs en haut → Codes de triche**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイ前に設定することも可能：**ゲームを選択 → 上部のスライダーボタン → チート**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以开玩前先开好：**选中游戏 → 顶栏调节图标 → 金手指**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以開玩前先開好：**選中游戲 → 頂欄調節圖示 → 金手指**。"
          }
        }
      }
    },
    "**Gear at the top right → Report a problem** at the bottom.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gear at the top right → Report a problem** at the bottom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Engranaje arriba a la derecha → Informar de un problema** al final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Roue dentée en haut à droite → Signaler un problème** en bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**右上の歯車 → 一番下の「問題を報告」**。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**右上角齿轮 → 最下面的「故障报修」**。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**右上角齒輪 → 最下面的「故障報修」**。"
          }
        }
      }
    },
    "Add a sentence about what happened (optional) and upload. You get a short code starting with **D-**; paste it in the group chat or a GitHub issue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a sentence about what happened (optional) and upload. You get a short code starting with **D-**; paste it in the group chat or a GitHub issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una frase sobre lo que ocurrió (opcional) y sube. Obtendrás un código corto que empieza con **D-**; pégalo en el chat del grupo o en un issue de GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une phrase sur ce qui s'est passé (facultatif) et téléversez. Vous obtenez un code court commençant par **D-** ; collez-le dans le groupe de discussion ou une issue GitHub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が起きたかを一言書いて（省略可）アップロード。**D-** で始まる短いコードが発行されるので、グループチャットや GitHub の Issue に貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写一句发生了什么（可以不写），点上传，会拿到一个 **D-** 开头的短码，贴到群里或 GitHub 帖子就行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫一句發生了什麼（可以不寫），點上傳，會拿到一個 **D-** 開頭的短碼，貼到群裡或 GitHub 帖子就行。"
          }
        }
      }
    },
