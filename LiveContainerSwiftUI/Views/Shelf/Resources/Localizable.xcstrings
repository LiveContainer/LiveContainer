    "Shared by all games; you can also switch it in a game any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für alle Spiele; lässt sich auch im Spiel jederzeit umschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared by all games; you can also switch it in a game any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartido por todos los juegos; también puedes cambiarlo dentro de un juego en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commun à tous les jeux ; activable aussi à tout moment en jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comune a tutti i giochi; si può attivare anche in gioco in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのゲームで共通。ゲーム中もいつでも切り替えられます。"
          }
        },
        "sv": {
