    "Drag the handle up or down to reorder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the handle up or down to reorder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el asa y arrástrala hacia arriba o abajo para reordenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la poignée vers le haut ou le bas pour réorganiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルを押したまま上下にドラッグして並べ替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住右侧拖动柄，上下调整游戏顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住右側拖動柄，上下調整遊戲順序。"
          }
        }
      }
    },
